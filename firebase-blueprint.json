{
  "entities": {
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Public brand, contact channel, social links, and site customization configuration for ISB Group.",
      "type": "object",
      "properties": {
        "brandNameEn": { "type": "string", "maxLength": 120 },
        "brandNameFa": { "type": "string", "maxLength": 120 },
        "instagramUrl": { "type": "string", "maxLength": 240 },
        "linkedinUrl": { "type": "string", "maxLength": 240 },
        "youtubeUrl": { "type": "string", "maxLength": 240 },
        "telegramUrl": { "type": "string", "maxLength": 240 },
        "whatsappUrl": { "type": "string", "maxLength": 240 },
        "publicEmail": { "type": "string", "maxLength": 160 },
        "publicPhone": { "type": "string", "maxLength": 60 },
        "studioCityEn": { "type": "string", "maxLength": 120 },
        "studioCityFa": { "type": "string", "maxLength": 120 },
        "teamCoverImage": { "type": "string", "maxLength": 500 },
        "teamCoverCaptionEn": { "type": "string", "maxLength": 200 },
        "teamCoverCaptionFa": { "type": "string", "maxLength": 200 },
        "heroTitleEn": { "type": "string", "maxLength": 160 },
        "heroTitleFa": { "type": "string", "maxLength": 160 },
        "heroSubtitleEn": { "type": "string", "maxLength": 400 },
        "heroSubtitleFa": { "type": "string", "maxLength": 400 },
        "aboutLeadEn": { "type": "string", "maxLength": 800 },
        "aboutLeadFa": { "type": "string", "maxLength": 800 },
        "hiddenSeedProjectSlugs": { "type": "array", "description": "Up to 20 seed project slugs hidden by admin." },
        "hiddenSeedCourseSlugs": { "type": "array", "description": "Up to 20 starter course slugs hidden by admin." },
        "hiddenSeedPartnerIds": { "type": "array", "description": "Up to 32 starter partner logo IDs hidden by admin." },
        "hiddenSeedInsightSlugs": { "type": "array", "description": "Up to 20 starter insight article slugs hidden by admin." },
        "hiddenSeedMaterialIds": { "type": "array", "description": "Up to 20 starter material IDs hidden by admin." },
        "paymentInstructionsFa": { "type": "string", "maxLength": 600 },
        "paymentInstructionsEn": { "type": "string", "maxLength": 600 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandNameEn", "brandNameFa", "instagramUrl", "updatedAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Compressed raster image uploaded by an authorized studio admin for projects, team profiles, or banners.",
      "type": "object",
      "properties": {
        "dataUrl": { "type": "string", "maxLength": 480000, "pattern": "^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$" },
        "contentType": { "type": "string", "enum": ["image/webp", "image/jpeg", "image/png"] },
        "sizeBytes": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dataUrl", "contentType", "sizeBytes", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Published or draft portfolio project with bilingual content, gallery, and image provenance disclosure.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9-]+$" },
        "titleEn": { "type": "string", "maxLength": 160 },
        "titleFa": { "type": "string", "maxLength": 160 },
        "cityEn": { "type": "string", "maxLength": 100 },
        "cityFa": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["administrative", "residential", "urban-park", "mixed-use", "cultural", "industrial", "educational"] },
        "serviceEn": { "type": "string", "maxLength": 100 },
        "serviceFa": { "type": "string", "maxLength": 100 },
        "disciplines": { "type": "array", "description": "Up to 3 discipline slugs." },
        "roleEn": { "type": "string", "maxLength": 300 },
        "roleFa": { "type": "string", "maxLength": 300 },
        "briefEn": { "type": "string", "maxLength": 1500 },
        "briefFa": { "type": "string", "maxLength": 1500 },
        "approachEn": { "type": "string", "maxLength": 1500 },
        "approachFa": { "type": "string", "maxLength": 1500 },
        "year": { "type": "string", "maxLength": 20 },
        "areaSqm": { "type": "string", "maxLength": 60 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "gallery": { "type": "array", "description": "Up to 8 gallery image URLs or media:// references." },
        "imageDisclosure": { "type": "string", "enum": ["concept", "photograph"] },
        "featuredOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "titleEn", "titleFa", "cityEn", "cityFa", "category", "serviceEn", "serviceFa", "disciplines", "coverImage", "imageDisclosure", "featuredOrder", "status", "updatedAt"]
    },
    "Insight": {
      "title": "Insight",
      "description": "Bilingual rich-block technical article, architectural monograph, or research note published by ISB Group.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 120, "pattern": "^[a-z0-9-]+$" },
        "titleEn": { "type": "string", "maxLength": 200 },
        "titleFa": { "type": "string", "maxLength": 200 },
        "subtitleEn": { "type": "string", "maxLength": 300 },
        "subtitleFa": { "type": "string", "maxLength": 300 },
        "excerptEn": { "type": "string", "maxLength": 600 },
        "excerptFa": { "type": "string", "maxLength": 600 },
        "bodyEn": { "type": "string", "maxLength": 24000 },
        "bodyFa": { "type": "string", "maxLength": 24000 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "coverCaptionEn": { "type": "string", "maxLength": 300 },
        "coverCaptionFa": { "type": "string", "maxLength": 300 },
        "authorEn": { "type": "string", "maxLength": 120 },
        "authorFa": { "type": "string", "maxLength": 120 },
        "authorRoleEn": { "type": "string", "maxLength": 140 },
        "authorRoleFa": { "type": "string", "maxLength": 140 },
        "readingTimeMinutes": { "type": "number" },
        "featured": { "type": "boolean" },
        "tagsEn": { "type": "array", "description": "Up to 8 English topic keywords." },
        "tagsFa": { "type": "array", "description": "Up to 8 Persian topic keywords." },
        "blocks": { "type": "array", "description": "Up to 40 native editorial content blocks (headings, rich text, Telegram-style multi-photo + text frames, split slides, metrics, callouts, quotes)." },
        "topic": { "type": "string", "enum": ["architecture", "energy-mep", "structure-seismic", "sustainability-lab"] },
        "publishedDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "titleEn", "titleFa", "excerptEn", "excerptFa", "bodyEn", "bodyFa", "topic", "publishedDate", "status", "updatedAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Approved staff profile with portrait, specialties, and resume published by ISB Group.",
      "type": "object",
      "properties": {
        "nameEn": { "type": "string", "maxLength": 120 },
        "nameFa": { "type": "string", "maxLength": 120 },
        "roleEn": { "type": "string", "maxLength": 140 },
        "roleFa": { "type": "string", "maxLength": 140 },
        "discipline": { "type": "string", "enum": ["architecture-urbanism", "energy-mep", "structure-seismic", "leadership"] },
        "tier": { "type": "string", "enum": ["ceo", "inspector", "board", "director", "specialist", "member", "advisor"] },
        "bioEn": { "type": "string", "maxLength": 800 },
        "bioFa": { "type": "string", "maxLength": 800 },
        "specialtiesEn": { "type": "string", "maxLength": 400 },
        "specialtiesFa": { "type": "string", "maxLength": 400 },
        "resumeEn": { "type": "string", "maxLength": 3000 },
        "resumeFa": { "type": "string", "maxLength": 3000 },
        "linkedinUrl": { "type": "string", "maxLength": 240 },
        "portraitUrl": { "type": "string", "maxLength": 500 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameEn", "nameFa", "roleEn", "roleFa", "discipline", "order", "status", "updatedAt"]
    },
    "PartnerLogo": {
      "title": "PartnerLogo",
      "description": "Collaborator, client, or sponsor logo displayed in the single-line logo ribbon and managed by Studio Admin.",
      "type": "object",
      "properties": {
        "nameFa": { "type": "string", "minLength": 1, "maxLength": 120 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 120 },
        "descriptionFa": { "type": "string", "maxLength": 240 },
        "descriptionEn": { "type": "string", "maxLength": 240 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "presetMarkId": { "type": "string", "maxLength": 60 },
        "websiteUrl": { "type": "string", "maxLength": 240 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nameFa", "nameEn", "order", "status", "updatedAt"]
    },
    "MaterialItem": {
      "title": "MaterialItem",
      "description": "Curated modern building material or technology system with certificate photo gallery, technical catalog link, and brand associations.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9-]+$" },
        "titleFa": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "subtitleFa": { "type": "string", "maxLength": 220 },
        "subtitleEn": { "type": "string", "maxLength": 220 },
        "summaryFa": { "type": "string", "maxLength": 1200 },
        "summaryEn": { "type": "string", "maxLength": 1200 },
        "category": { "type": "string", "enum": ["thermal-envelope", "lightweight-structure", "facade-glazing", "smart-energy"] },
        "brandNameFa": { "type": "string", "maxLength": 120 },
        "brandNameEn": { "type": "string", "maxLength": 120 },
        "performanceMetric": { "type": "string", "maxLength": 40 },
        "performanceLabelFa": { "type": "string", "maxLength": 100 },
        "performanceLabelEn": { "type": "string", "maxLength": 100 },
        "standardRefFa": { "type": "string", "maxLength": 120 },
        "standardRefEn": { "type": "string", "maxLength": 120 },
        "applicationFa": { "type": "string", "maxLength": 240 },
        "applicationEn": { "type": "string", "maxLength": 240 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "certificates": { "type": "array", "description": "Up to 8 certificate image objects with imageUrl and optional title/issuer metadata." },
        "catalogUrl": { "type": "string", "maxLength": 500 },
        "catalogLabelFa": { "type": "string", "maxLength": 120 },
        "catalogLabelEn": { "type": "string", "maxLength": 120 },
        "partnerIds": { "type": "array", "description": "Up to 8 linked partner brand IDs." },
        "featured": { "type": "boolean" },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "titleFa", "titleEn", "category", "coverImage", "order", "status", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Bilingual architectural, energy, or structural training course managed by Studio Admin and directly enrollable by members.",
      "type": "object",
      "properties": {
        "slug": { "type": "string", "maxLength": 100, "pattern": "^[a-z0-9-]+$" },
        "titleFa": { "type": "string", "minLength": 2, "maxLength": 160 },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 160 },
        "department": { "type": "string", "enum": ["architecture-urbanism", "energy-mep", "structure-seismic", "multidisciplinary"] },
        "format": { "type": "string", "enum": ["online-live", "recorded", "in-person", "hybrid"] },
        "instructorFa": { "type": "string", "minLength": 2, "maxLength": 120 },
        "instructorEn": { "type": "string", "minLength": 2, "maxLength": 120 },
        "durationFa": { "type": "string", "minLength": 2, "maxLength": 80 },
        "durationEn": { "type": "string", "minLength": 2, "maxLength": 80 },
        "scheduleFa": { "type": "string", "maxLength": 160 },
        "scheduleEn": { "type": "string", "maxLength": 160 },
        "priceToman": { "type": "number" },
        "originalPriceToman": { "type": "number" },
        "capacity": { "type": "number" },
        "summaryFa": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "summaryEn": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "syllabusFa": { "type": "array", "description": "Up to 16 Persian syllabus items." },
        "syllabusEn": { "type": "array", "description": "Up to 16 English syllabus items." },
        "coverImage": { "type": "string", "maxLength": 500 },
        "paymentUrl": { "type": "string", "maxLength": 500 },
        "paymentNoteFa": { "type": "string", "maxLength": 600 },
        "paymentNoteEn": { "type": "string", "maxLength": 600 },
        "accessUrl": { "type": "string", "maxLength": 500 },
        "featuredOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["slug", "titleFa", "titleEn", "department", "format", "instructorFa", "instructorEn", "durationFa", "durationEn", "priceToman", "summaryFa", "summaryEn", "coverImage", "featuredOrder", "status", "updatedAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Project inquiry or partnership request submitted by a verified member, with staff reply visible to the submitter.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" },
        "phone": { "type": "string", "maxLength": 40 },
        "organization": { "type": "string", "maxLength": 140 },
        "projectType": { "type": "string", "maxLength": 80 },
        "disciplines": { "type": "array", "description": "Up to 4 selected discipline slugs." },
        "city": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "locale": { "type": "string", "enum": ["en", "fa"] },
        "internalStatus": { "type": "string", "enum": ["new", "reviewing", "contacted", "archived"] },
        "adminReply": { "type": "string", "maxLength": 4000 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "repliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "projectType", "disciplines", "message", "locale", "internalStatus", "createdAt"]
    },
    "AssessmentRequest": {
      "title": "AssessmentRequest",
      "description": "Sustainability Lab assessment intake request submitted by a verified member, with staff reply visible to the submitter.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "minLength": 5, "maxLength": 160, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$" },
        "phone": { "type": "string", "maxLength": 40 },
        "organization": { "type": "string", "maxLength": 140 },
        "projectType": { "type": "string", "minLength": 2, "maxLength": 80 },
        "city": { "type": "string", "minLength": 2, "maxLength": 100 },
        "approximateFloorAreaSqm": { "type": "number" },
        "projectStage": { "type": "string", "enum": ["concept", "schematic", "detailed", "construction", "existing"] },
        "assessmentGoals": { "type": "array", "description": "1 to 6 selected assessment goal identifiers." },
        "notes": { "type": "string", "maxLength": 2000 },
        "locale": { "type": "string", "enum": ["en", "fa"] },
        "internalStatus": { "type": "string", "enum": ["new", "reviewing", "scheduled", "completed", "archived"] },
        "adminReply": { "type": "string", "maxLength": 4000 },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "repliedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "projectType", "city", "approximateFloorAreaSqm", "projectStage", "assessmentGoals", "locale", "internalStatus", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized ISB Group staff registry entry.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin", "editor"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered ISB member profile storing complete identity, contact, and billing readiness details for future courses and payments.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "email": { "type": "string", "maxLength": 160, "description": "Valid email address or empty string when authenticated exclusively via Phone SMS OTP." },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 40 },
        "nationalId": { "type": "string", "maxLength": 20 },
        "city": { "type": "string", "maxLength": 100 },
        "organization": { "type": "string", "maxLength": 140 },
        "profession": { "type": "string", "maxLength": 120 },
        "billingAddress": { "type": "string", "maxLength": 500 },
        "locale": { "type": "string", "enum": ["en", "fa"] },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "role", "createdAt", "updatedAt", "lastLoginAt"]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "Course enrollment, workshop, or consultation order associated with a registered user.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[A-Z0-9-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "userEmail": { "type": "string", "maxLength": 160 },
        "userFullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "userPhone": { "type": "string", "maxLength": 40 },
        "courseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "itemType": { "type": "string", "enum": ["course", "workshop", "consultation", "publication"] },
        "titleFa": { "type": "string", "minLength": 2, "maxLength": 180 },
        "titleEn": { "type": "string", "minLength": 2, "maxLength": 180 },
        "amountToman": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "cancelled", "refunded"] },
        "paymentGateway": { "type": "string", "maxLength": 60 },
        "paymentRef": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 1500 },
        "accessUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "userId", "userEmail", "userFullName", "itemType", "titleFa", "titleEn", "amountToman", "paymentStatus", "createdAt", "updatedAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Member support or technical consultation ticket with threaded replies and status tracking.",
      "type": "object",
      "properties": {
        "ticketNumber": { "type": "string", "minLength": 4, "maxLength": 40, "pattern": "^[A-Z0-9-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "userEmail": { "type": "string", "maxLength": 160 },
        "userFullName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "subject": { "type": "string", "minLength": 3, "maxLength": 160 },
        "category": { "type": "string", "enum": ["courses", "orders-billing", "technical", "general"] },
        "priority": { "type": "string", "enum": ["normal", "high"] },
        "status": { "type": "string", "enum": ["open", "in-progress", "answered", "closed"] },
        "initialMessage": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "lastReplyBy": { "type": "string", "enum": ["user", "admin"] },
        "replyCount": { "type": "number" },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "locale": { "type": "string", "enum": ["en", "fa"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastReplyAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketNumber", "userId", "userEmail", "userFullName", "subject", "category", "priority", "status", "initialMessage", "lastReplyBy", "replyCount", "locale", "createdAt", "updatedAt"]
    },
    "TicketMessage": {
      "title": "TicketMessage",
      "description": "Immutable threaded reply inside a member support ticket.",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "ticketOwnerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "senderUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_-]+$" },
        "senderName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "senderRole": { "type": "string", "enum": ["user", "admin"] },
        "body": { "type": "string", "minLength": 2, "maxLength": 3000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ticketId", "ticketOwnerId", "senderUid", "senderName", "senderRole", "body", "createdAt"]
    }
  },
  "firestore": {
    "/siteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Public site settings & customization document (id: main)."
    },
    "/mediaAssets/{mediaId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Admin-uploaded compressed raster images readable individually by ID."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Portfolio projects readable publicly when published."
    },
    "/insights/{insightId}": {
      "schema": { "$ref": "#/entities/Insight" },
      "description": "Technical articles readable publicly when published."
    },
    "/teamMembers/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Approved staff profiles readable publicly when published."
    },
    "/partnerLogos/{partnerId}": {
      "schema": { "$ref": "#/entities/PartnerLogo" },
      "description": "Partner logos readable publicly when published and managed by Studio Admin."
    },
    "/materials/{materialId}": {
